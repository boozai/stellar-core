// Default values for version, can be overridden by configure_file if a version.h.in is used
#ifndef SODIUM_VERSION_STRING
#define SODIUM_VERSION_STRING "1.0.18-cmake" // Placeholder version
#endif
#ifndef SODIUM_LIBRARY_VERSION_MAJOR
#define SODIUM_LIBRARY_VERSION_MAJOR 10
#endif
#ifndef SODIUM_LIBRARY_VERSION_MINOR
#define SODIUM_LIBRARY_VERSION_MINOR 3
#endif

