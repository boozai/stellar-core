/* sodium_config.h.in. Generated by CMake. */

/* Define to 1 if you have the <inttypes.h> header file. */
#cmakedefine HAVE_INTTYPES_H 1

/* Define to 1 if you have the <stdint.h> header file. */
#cmakedefine HAVE_STDINT_H 1

/* Define to 1 if you have the <stdbool.h> header file. */
#cmakedefine HAVE_STDBOOL_H 1

/* Define to 1 if you have weak symbols. */
#cmakedefine HAVE_WEAK_SYMBOLS 1

/* Define to 1 if targeting a little-endian system */
#cmakedefine NATIVE_LITTLE_ENDIAN 1

/* Define to empty if `const' does not conform to ANSI C. */
/* #undef const */

/* Define to `__inline__' or `__inline' if that's what the C compiler
   calls it, or to nothing if 'inline' is not supported under any name.  */
#ifndef __cplusplus
/* #undef inline */
#endif

/* The size of `size_t', as computed by sizeof. */
#cmakedefine SIZEOF_SIZE_T @SIZEOF_SIZE_T@

/* Define to `unsigned int' if <sys/types.h> does not define. */
/* #undef size_t */

// Add any other defines that are critical and can be reasonably assumed or checked.
// For example, CPU feature detections (HAVE_AVX2, etc.) are usually done by configure.
// We are simplifying here.

#define SODIUM_EXPORT
#define SODIUM_STATIC
#define SODIUM_DLL_EXPORT
